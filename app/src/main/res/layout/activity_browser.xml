<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0B0F14">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#111820"
        app:tabTextColor="#80FFFFFF"
        app:tabSelectedTextColor="#00E5FF"
        app:tabIndicatorColor="#00E5FF"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#111820"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvSelection"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Belum ada item dipilih"
            android:textColor="#B0BEC5" android:textSize="12sp"
            android:paddingBottom="4dp"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="🚀 Pilih file dulu"
            android:textSize="14sp"
            android:enabled="false"/>
    </LinearLayout>
</LinearLayout>
