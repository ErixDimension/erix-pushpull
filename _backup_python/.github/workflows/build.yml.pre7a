name: Build ERIX APK

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build-android:
    runs-on: ubuntu-latest
    timeout-minutes: 90

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            git zip unzip \
            openjdk-17-jdk-headless \
            autoconf automake autoconf-archive \
            libtool libtool-bin libltdl-dev \
            pkg-config \
            zlib1g-dev libncurses5-dev libncursesw5-dev \
            libtinfo6 cmake libffi-dev libssl-dev

      - name: Install buildozer
        run: |
          python -m pip install --upgrade pip
          pip install buildozer cython==0.29.36 virtualenv

      - name: Cache buildozer global directory
        uses: actions/cache@v4
        with:
          path: ~/.buildozer
          key: buildozer-global-${{ runner.os }}-${{ hashFiles('buildozer.spec') }}
          restore-keys: |
            buildozer-global-${{ runner.os }}-

      - name: Cache buildozer project directory
        uses: actions/cache@v4
        with:
          path: .buildozer
          key: buildozer-project-v3-${{ runner.os }}-${{ hashFiles('buildozer.spec') }}
          restore-keys: |
            buildozer-project-v3-${{ runner.os }}-

      - name: Clean stale libffi build (fix retry)
        run: |
          rm -rf .buildozer/android/platform/build-*/build/libffi 2>/dev/null || true
          rm -rf .buildozer/android/platform/build-*/build/libffi_* 2>/dev/null || true
          echo "=== Cleaned stale libffi builds ==="
          ls -la .buildozer/android/platform/ 2>/dev/null | head -5 || echo "(empty)"

      - name: Build APK with buildozer
        run: |
          set -o pipefail
          export ACLOCAL_PATH=/usr/share/aclocal
          yes | buildozer -v android debug 2>&1 | tee build.log

      - name: Debug - list build artifacts
        if: always()
        run: |
          echo "=== Files in bin/ ==="
          ls -la bin/ 2>/dev/null || echo "bin/ not found"
          echo ""
          echo "=== APK anywhere ==="
          find . -name "*.apk" -type f 2>/dev/null || echo "no APK found"
          echo ""
          echo "=== Dist directory ==="
          find .buildozer/android/platform/build-*/dists -type f -name "*.apk" 2>/dev/null || echo "no dists APK"
          echo ""
          echo "=== Build status from log ==="
          grep -E "Command failed|Android packaging done|BUILD SUCCESSFUL|BUILD FAILED" build.log 2>/dev/null | tail -10 || true

      - name: Upload APK artifact
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: erix-apk
          path: |
            bin/*.apk
            .buildozer/android/platform/build-*/dists/*/bin/*.apk
          if-no-files-found: error
          retention-days: 30

      - name: Upload build log (on failure)
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: build-log
          path: build.log
          retention-days: 7
