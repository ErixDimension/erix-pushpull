<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B0F14">
    <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="#111820" android:textColor="#00E5FF" android:textStyle="bold" android:textSize="16sp" android:text="BROWSER"/>
    <TextView android:id="@+id/tvPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:background="#0F1620" android:textColor="#B0BEC5" android:textSize="12sp" android:maxLines="2" android:ellipsize="start" android:text="/sdcard"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvItems" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="#111820" android:padding="4dp">
        <Button android:id="@+id/btnUp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="↑"/>
        <Button android:id="@+id/btnDown" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="↓"/>
        <Button android:id="@+id/btnSelect" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="2" android:text="PILIH"/>
        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="2" android:text="← KEMBALI"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="#111820" android:padding="4dp">
        <Button android:id="@+id/btnSelectMode" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="☑ Multi"/>
        <Button android:id="@+id/btnBasket" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🧺 Basket"/>
        <Button android:id="@+id/btnNewFolder" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="+ Folder"/>
        <Button android:id="@+id/btnExtract" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="📦 Extract"/>
    </LinearLayout>
</LinearLayout>
