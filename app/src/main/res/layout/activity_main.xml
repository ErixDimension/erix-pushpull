<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#080D14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ERIX"
            android:textColor="#53E6D0"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:gravity="center_vertical"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PUSHPULL  •  V49"
            android:textColor="#9AAFC4"
            android:textSize="12sp"
            android:letterSpacing="0.16"
            android:paddingBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#111C29">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BUGJAEGER COMPATIBILITY"
                android:textColor="#53E6D0"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diagnostik framing dan koneksi endpoint lokal. Token tidak ditulis ke log."
                android:textColor="#B8C7D8"
                android:textSize="12sp"
                android:paddingTop="6dp"
                android:paddingBottom="12dp"/>

            <EditText
                android:id="@+id/etService"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:singleLine="true"
                android:paddingHorizontal="12dp"
                android:hint="Service, contoh: host:version"
                android:text="host:version"
                android:textColor="#FFFFFF"
                android:textColorHint="#71849A"
                android:backgroundTint="#53E6D0"
                android:inputType="text"/>

            <EditText
                android:id="@+id/etToken"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:paddingHorizontal="12dp"
                android:hint="sxtoken (isi sendiri)"
                android:textColor="#FFFFFF"
                android:textColorHint="#71849A"
                android:backgroundTint="#53E6D0"
                android:inputType="textPassword"/>

            <Button
                android:id="@+id/btnBugjaeger"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="UJI KONEKSI BUGJAEGER"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menunggu pengujian..."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingTop="12dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DIAGNOSTIC LOG"
                android:textColor="#9AAFC4"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Clear"/>

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:text="Copy"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="220dp"
            android:padding="14dp"
            android:background="#0E1722"
            android:textColor="#9AF5C7"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USB ADB dan Bugjaeger TCP adalah jalur terpisah. Koneksi sukses belum berarti push/pull sudah tersedia."
            android:textColor="#71849A"
            android:textSize="11sp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"/>
    </LinearLayout>
</ScrollView>
