<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#0B0F14">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✦ Terang Bulan ✦" android:textColor="#00E5FF" android:textSize="20sp" android:gravity="center" android:textStyle="bold"/>
    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Menunggu device..." android:textColor="#FFFFFF" android:gravity="center" android:paddingBottom="8dp"/>
    
    <Button android:id="@+id/btnPermission" android:layout_width="match_parent" android:layout_height="48dp"
        android:text="🔓 Izinkan Akses Penyimpanan" android:backgroundTint="#FF5252" android:textColor="#FFFFFF" 
        android:visibility="gone" android:layout_marginBottom="6dp"/>

    <Button android:id="@+id/btnOpenBrowser" android:layout_width="match_parent" android:layout_height="52dp"
        android:text="🌐 Buka Browser" android:textSize="14sp" android:enabled="false" android:layout_marginBottom="6dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="Clear"/>
        <Button android:id="@+id/btnCopy" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="Copy Log" android:layout_marginStart="4dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#111820" android:padding="8dp" android:layout_marginTop="4dp">
        <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#00FF00" android:textSize="10sp" android:fontFamily="monospace"/>
    </ScrollView>
</LinearLayout>
