<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_dialog_dark"
    android:padding="20dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="⚠ File Lebih dari 4 GB"
        android:textColor="#FFC107" android:textSize="18sp" android:textStyle="bold"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Protokol PTP tidak bisa kirim file >4GB dalam satu tarikan. File harus dipecah dulu di TWRP."
        android:textColor="#B0BEC5" android:textSize="12sp"
        android:paddingTop="6dp" android:paddingBottom="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📋 Langkah:"
        android:textColor="#00E5FF" android:textSize="13sp" android:textStyle="bold"/>

    <TextView android:id="@+id/tvSteps"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="12sp"
        android:fontFamily="monospace"
        android:paddingTop="4dp" android:paddingBottom="12dp"
        android:textIsSelectable="true"/>

    <TextView android:id="@+id/tvCommand"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#00FF00" android:textSize="11sp"
        android:fontFamily="monospace"
        android:background="#0F1419" android:padding="8dp"
        android:textIsSelectable="true"
        android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Setelah selesai, klik tombol di bawah. Aplikasi akan deteksi otomatis &amp; download semua bagian."
        android:textColor="#90A4AE" android:textSize="11sp"
        android:paddingBottom="12dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnCopyCmd"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:text="📋 Salin"
            android:layout_marginEnd="4dp"/>

        <Button android:id="@+id/btnAlreadySplit"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:text="✓ Sudah Split"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <Button android:id="@+id/btnCancel"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:text="Batal"
        android:layout_marginTop="4dp"/>
</LinearLayout>
