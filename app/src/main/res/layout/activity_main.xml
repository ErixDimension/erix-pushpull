<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="#0B0F14">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✦ ERIX PTP v50 ✦" android:textColor="#00E5FF" android:textSize="20sp"
        android:gravity="center" android:textStyle="bold"/>

    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Menunggu device..."
        android:textColor="#FFFFFF" android:gravity="center" android:paddingBottom="6dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnTest" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:text="🔌 Test" android:textSize="11sp" android:layout_marginEnd="2dp"/>
        <Button android:id="@+id/btnPush" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:text="📤 PUSH" android:textSize="11sp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"/>
        <Button android:id="@+id/btnPull" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:text="📥 PULL" android:textSize="11sp" android:layout_marginStart="2dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_weight="1" android:text="Clear" android:textSize="10sp" android:layout_marginEnd="2dp"/>
        <Button android:id="@+id/btnCopy" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_weight="1" android:text="📋 Copy Log" android:textSize="10sp" android:layout_marginStart="2dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#111820" android:padding="6dp"
        android:layout_marginTop="4dp">
        <TextView android:id="@+id/tvLog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#00FF00"
            android:textSize="10sp" android:fontFamily="monospace"/>
    </ScrollView>
</LinearLayout>
