<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_dialog_dark"
    android:padding="20dp">

    <LinearLayout android:id="@+id/storageBanner"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#252525"
        android:padding="10dp" android:layout_marginBottom="12dp">

        <TextView android:id="@+id/tvStorageIcon"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="✓" android:textColor="#00E5FF" android:textSize="18sp"/>

        <TextView android:id="@+id/tvStorageText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="#FFFFFF" android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <ProgressBar android:id="@+id/storageBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:max="100" android:progress="0"
            android:progressTint="#00E5FF" android:progressBackgroundTint="#1A2027"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📦 Cara Kirim File" android:textColor="#FFFFFF"
        android:textSize="16sp" android:textStyle="bold" android:paddingBottom="4dp"/>

    <TextView android:id="@+id/tvFileInfo"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#B0BEC5" android:textSize="12sp"
        android:paddingBottom="12dp"/>

    <RadioGroup android:id="@+id/rgMode"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton android:id="@+id/rbResumable"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🔄 Bisa Dilanjutkan" android:textColor="#FFFFFF"
            android:textSize="15sp" android:paddingTop="8dp"/>

        <TextView android:id="@+id/tvResumableDesc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Kalau kabel putus, lanjut dari posisi terakhir tanpa mulai ulang"
            android:textColor="#90A4AE" android:textSize="12sp"
            android:paddingStart="32dp" android:paddingEnd="8dp"/>

        <TextView android:id="@+id/tvResumableInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ⓘ Butuh tempat 2× ukuran file untuk penggabungan"
            android:textColor="#4DD0E1" android:textSize="11sp"
            android:paddingStart="32dp" android:paddingEnd="8dp"
            android:paddingBottom="12dp"/>

        <RadioButton android:id="@+id/rbDirect"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚡ Sekali Jalan" android:textColor="#FFFFFF"
            android:textSize="15sp"/>

        <TextView android:id="@+id/tvDirectDesc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Kirim langsung dalam satu proses"
            android:textColor="#90A4AE" android:textSize="12sp"
            android:paddingStart="32dp" android:paddingEnd="8dp"/>

        <TextView android:id="@+id/tvDirectInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ⓘ Butuh tempat 1× ukuran file"
            android:textColor="#4DD0E1" android:textSize="11sp"
            android:paddingStart="32dp" android:paddingEnd="8dp"
            android:paddingBottom="12dp"/>
    </RadioGroup>

    <TextView android:id="@+id/tvSuggestion"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#FFC107" android:textSize="12sp"
        android:visibility="gone" android:paddingBottom="12dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnCancel"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:text="❌ Batal"
            android:layout_marginEnd="4dp"/>

        <Button android:id="@+id/btnStart"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:text="🚀 Mulai Transfer"
            android:enabled="false" android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
